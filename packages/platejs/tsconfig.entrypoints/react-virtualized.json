{
  "compilerOptions": {
    "composite": true,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/react-virtualized",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/react-virtualized.tsbuildinfo"
  },
  "exclude": [
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/react/virtualized.*"],
  "references": [
    {
      "path": "../../plitejs/tsconfig.entrypoints/react-virtualized.json"
    },
    {
      "path": "./react-core.json"
    }
  ]
}
