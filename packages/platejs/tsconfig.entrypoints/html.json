{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": true,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/html",
    "rootDir": "../src",
    "sourceMap": false,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/html.tsbuildinfo"
  },
  "exclude": [
    "../src/html/server/**/*",
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/html/**/*"],
  "references": [
    {
      "path": "./core.json"
    }
  ]
}
