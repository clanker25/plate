{
  "compilerOptions": {
    "composite": true,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": false,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/docx-internal",
    "rootDir": "../src",
    "sourceMap": true,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/docx-internal.tsbuildinfo"
  },
  "exclude": [
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/docx/internal/**/*"],
  "references": [
    {
      "path": "./authored.json"
    },
    {
      "path": "./core.json"
    }
  ]
}
