{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "incremental": false,
    "noEmit": false,
    "outDir": "../.turbo/entrypoint-types/device",
    "rootDir": "../src",
    "sourceMap": true,
    "tsBuildInfoFile": "../.turbo/entrypoint-types/device.tsbuildinfo"
  },
  "exclude": [
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "../src/**/*-contract.*",
    "../src/**/__tests__/**"
  ],
  "extends": "../tsconfig.json",
  "include": ["../src/device/**/*"],
  "references": [
    {
      "path": "./playwright.json"
    }
  ]
}
